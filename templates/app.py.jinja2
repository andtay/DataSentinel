@app.post("/validate", response_model=ValidationResponse, tags=["Validation"])
async def validate_api(request: ValidationRequest):
    """
    Validate all API endpoints.
    
    Validates all endpoints of the target API and returns detailed results.
    """
    import time
    
    report = ValidationReport()
    results: List[ValidationResult] = []
    
    async with APIValidator(
        base_url=request.target_url,
        timeout=30.0,
        max_retries=3,
    ) as validator:
        {% for endpoint in api_schema.endpoints %}
        # Validate {{ endpoint.method }} {{ endpoint.path }}
        try:
            start_time = time.time()
            
            {% if endpoint.parameters %}
            # Get parameters from request
            params = request.{{ endpoint.get_function_name() }}_params or {}
            result = await validator.validate_{{ endpoint.get_function_name() }}(
                {% for param in endpoint.parameters %}
                {% if param.required %}
                {{ param.name }}=params.get("{{ param.name }}", {{ _get_default_param_value(param) }}),
                {% else %}
                {{ param.name }}=params.get("{{ param.name }}"),
                {% endif %}
                {% endfor %}
            )
            {% else %}
            result = await validator.validate_{{ endpoint.get_function_name() }}()
            {% endif %}
            
            response_time = (time.time() - start_time) * 1000
            
            results.append(ValidationResult(
                endpoint="{{ endpoint.path }}",
                method="{{ endpoint.method }}",
                success=True,
                response_time_ms=response_time,
            ))
            report.add_result("{{ endpoint.path }}", True)
            
        except ValidationException as e:
            results.append(ValidationResult(
                endpoint="{{ endpoint.path }}",
                method="{{ endpoint.method }}",
                success=False,
                error=str(e),
            ))
            report.add_result("{{ endpoint.path }}", False, error=str(e))
            
        except Exception as e:
            logger.error(f"Unexpected error validating {{ endpoint.path }}: {e}")
            results.append(ValidationResult(
                endpoint="{{ endpoint.path }}",
                method="{{ endpoint.method }}",
                success=False,
                error=f"Unexpected error: {str(e)}",
            ))
            report.add_result("{{ endpoint.path }}", False, error=str(e))
        
        {% endfor %}
    
    return ValidationResponse(
        api_title="{{ api_schema.title }}",
        api_version="{{ api_schema.version }}",
        target_url=request.target_url,
        results=results,
        summary=report.get_summary(),
    )


